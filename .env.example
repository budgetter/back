# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Database (MySQL) ---
# For local Docker (see docker-compose.yml), DB_HOST/DB_USER are overridden
# to "db"/"root" automatically - only DB_PASS and DB_NAME matter there.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=budgetter

# development | production
# In development, back/server.js runs migrations + seeders on startup.
NODE_ENV=development

# --- Auth ---
JWT_SECRET=
# Optional: lets tokens signed with a previous secret keep validating during rotation.
OLD_JWT_SECRET=

# --- Encryption (required at startup, see back/utils/encryption.js) ---
ENCRYPTION_KEY=

# --- CORS ---
# Frontend origin allowed to call the API.
ORIGIN_URL=http://localhost:5173

# --- Google OAuth (Gmail bank-email integration) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_INTEGRATION_CALLBACK_URL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
